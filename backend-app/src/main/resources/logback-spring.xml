<?xml version="1.0" encoding="UTF-8"?>
<configuration packagingData="true" debug="false" scan="false" scanPeriod="30 seconds">

    <!-- 監聽 Logback 內部狀態並印在控制台 -->
    <statusListener class="ch.qos.logback.core.status.OnConsoleStatusListener" />

    <!-- 定義appender :
         - 只輸出到 console
         - %highlight 讓 ERROR 顯示紅色、WARN 顯示黃色（ANSI 色碼，IDE/Terminal 可見，log 檔案中是亂碼所以不用在 DAYFILE 裡）
         - %class.%method(%file:%line) 顯示哪個類別第幾行呼叫的
    -->

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%date{HH:mm:ss.SSS} | [%highlight(%-5level)] - %msg, %blue(%class.%method\(%file:%line\)), %yellow([%thread]) %n</pattern>
        </encoder>
    </appender>

    <!-- 定義每天產生一個新的 log 檔案，並且當檔案大小超過 15MB 時切割成多個檔案，保留最近 30 天的檔案，總大小不超過 2GB -->
    <appender name="DAYFILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-logs}/reporter-api.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-logs}/reporter-api_%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>15MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>[%date] [%-5level] - %msg, %class.%method\(%file:%line\), [%thread] %n</pattern>
        </encoder>
    </appender>


    <!-- 定義 Logstash appender，只有在 lab、beta、prod 環境才啟用 -->
    <springProperty scope="context" name="profile" source="spring.profiles.active"/>
    <springProperty scope="context" name="logging_file_name" source="logging.file.name"/>
    <springProfile name="lab | beta | prod">
        <variable resource="logstash.properties"/>
        <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
            <destination>${logstash.host:-localhost}:${logstash.port:-5044}</destination>
            <reconnectionDelay>10000</reconnectionDelay> <!-- 每 10 秒重試連線 -->
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeCallerData>false</includeCallerData>
                <customFields>{"service": "reporter", "app":"${logging_file_name:-reporter-api}", "env": "${profile}"}</customFields>
            </encoder>
        </appender>

        <!-- 使用 AsyncAppender 來非同步寫入 LOGSTASH，不阻塞主執行緒 -->
        <appender name="ASYNC_LOGSTASH" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="LOGSTASH"/>
            <discardingThreshold>0</discardingThreshold>
            <queueSize>1024</queueSize>
            <neverBlock>true</neverBlock>
        </appender>

        <!-- 在 lab、beta、prod 環境輸出到 console、log 檔案和 Logstash，並且只輸出 WARN 級別以上的日誌到 Logstash -->
        <root level="WARN">
            <appender-ref ref="ASYNC_LOGSTASH"/>
            <appender-ref ref="STDOUT" />
            <appender-ref ref="DAYFILE" />
        </root>

    </springProfile>

    <!-- 在 default、dev、dev-lab 環境只輸出到 console 和 log 檔案，不送到 Logstash -->
    <springProfile name="default | dev | dev-lab">
        <root level="INFO">
            <appender-ref ref="STDOUT" />
            <appender-ref ref="DAYFILE" />
        </root>
    </springProfile>

    <!-- <logger name="org.hibernate.loader" level="DEBUG" additivity="true"/> --> <!-- Entity Graph -->
    <!-- <logger name="org.hibernate.type" level="TRACE" additivity="true"/> --> <!-- JPQL Parameter Value -->

